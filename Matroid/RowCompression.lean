import Matroid.Representation
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! Removing dependent rows after column restriction. -/

namespace Matrix

/-- Every row of a column-restricted matrix is generated by retained rows
if and only if it admits a row-coordinate factorization. -/
theorem exists_rowCompression_factor {r c K : Type*} [Field K]
    [Fintype c] (A : Matrix r c K) (S : Set r) [Fintype S]
    (hspan : ∀ i, A.row i ∈
      Submodule.span K (Set.range (A.submatrix (fun s : S => s.1) id).row)) :
    ∃ T : Matrix r S K, A = T * A.submatrix (fun s : S => s.1) id := by
  classical
  choose t ht using fun i =>
    (Submodule.mem_span_range_iff_exists_fun K).mp (hspan i)
  refine ⟨fun i s => t i s, ?_⟩
  ext i j
  have hij := congrFun (ht i) j
  change A i j = ∑ s : S, t i s * A s.1 j
  simpa [Matrix.row, smul_eq_mul] using hij.symm

/-- After column restriction, a reconstruction equation holds on every row
exactly when it holds on a spanning collection of retained rows. The vector
`v` can contain any prescribed column factors and available-set mask. -/
theorem rowCompression_reconstruction_iff {r c K : Type*} [Field K]
    [Fintype c] (A : Matrix r c K) (S : Set r) [Fintype S]
    (hspan : ∀ i, A.row i ∈
      Submodule.span K (Set.range (A.submatrix (fun s : S => s.1) id).row))
    (τ : c) (v : c → K) :
    (A.submatrix (fun s : S => s.1) id).mulVec v =
      (A.submatrix (fun s : S => s.1) id).col τ ↔
      A.mulVec v = A.col τ := by
  classical
  let B := A.submatrix (fun s : S => s.1) id
  obtain ⟨T, hA⟩ := exists_rowCompression_factor A S hspan
  have hrestrict (x : c → K) : B.mulVec x = A.mulVec x ∘ (fun s : S => s.1) := by
    simpa [B] using Matrix.submatrix_mulVec_equiv A x
      (fun s : S => s.1) (Equiv.refl c)
  have htarget : B.col τ = A.col τ ∘ (fun s : S => s.1) := rfl
  constructor
  · intro h
    have htarget' : A.col τ = T.mulVec (B.col τ) := by
      rw [hA]
      exact Matrix.col_mul_eq_mulVec_col
    calc
      A.mulVec v = (T * B).mulVec v := by rw [hA]
      _ = T.mulVec (B.mulVec v) := (Matrix.mulVec_mulVec v T B).symm
      _ = T.mulVec (B.col τ) := by rw [h]
      _ = A.col τ := htarget'.symm
  · intro h
    rw [hrestrict, htarget, h]

/-- The two directions of the manuscript's weighted available-column
reconstruction equation survive deletion of dependent rows. The target column
is kept separate from the available columns. -/
theorem rowCompression_weightedReconstruction_iff {r c K : Type*} [Field K]
    [Fintype c] [DecidableEq c] (A : Matrix r c K) (S : Set r) [Fintype S]
    (hspan : ∀ i, A.row i ∈
      Submodule.span K (Set.range (A.submatrix (fun s : S => s.1) id).row))
    (τ : c) (F : Finset c) (_hτ : τ ∉ F)
    (weightCoeff a : c → K) :
    (A.submatrix (fun s : S => s.1) id).mulVec
        (fun e => if e ∈ F then weightCoeff e * a e else 0) =
      (A.submatrix (fun s : S => s.1) id).col τ ↔
    A.mulVec (fun e => if e ∈ F then weightCoeff e * a e else 0) = A.col τ :=
  rowCompression_reconstruction_iff A S hspan τ _

end Matrix

namespace Matroid

/-- Row compression after column restriction preserves every indexed
independent set, including repeated or zero columns. -/
theorem rowCompression_vectorMatroid_eq {r c K : Type*} [Field K]
    [Fintype c] (A : Matrix r c K) (S : Set r) [Fintype S]
    (hspan : ∀ i, A.row i ∈
      Submodule.span K (Set.range (A.submatrix (fun s : S => s.1) id).row))
    (E : Set c) (hE : E.Finite) :
    vectorMatroid (K := K) E hE A.col =
      vectorMatroid (K := K) E hE
        (A.submatrix (fun s : S => s.1) id).col := by
  classical
  let B := A.submatrix (fun s : S => s.1) id
  obtain ⟨T, hA⟩ := Matrix.exists_rowCompression_factor A S hspan
  let P : (r → K) →ₗ[K] (S → K) := LinearMap.funLeft K K (fun s : S => s.1)
  have hBcol (j : c) : B.col j = P (A.col j) := rfl
  have hAcol (j : c) : A.col j = T.mulVecLin (B.col j) := by
    rw [hA]
    exact Matrix.col_mul_eq_mulVec_col
  apply Matroid.ext_indep (by simp)
  intro I hI
  rw [vectorMatroid_indep_iff, vectorMatroid_indep_iff]
  constructor
  · rintro ⟨_, hLI⟩
    refine ⟨hI, ?_⟩
    have hLI' : LinearIndependent K
        (T.mulVecLin ∘ (fun i : I => B.col i.1)) := by
      simpa [Function.comp_def, hAcol] using hLI
    exact LinearIndependent.of_comp T.mulVecLin hLI'
  · rintro ⟨_, hLI⟩
    refine ⟨hI, ?_⟩
    have hLI' : LinearIndependent K
        (P ∘ (fun i : I => A.col i.1)) := by
      have hfun : (fun i : I => B.col i.1) =
          P ∘ (fun i : I => A.col i.1) := by
        funext i
        exact hBcol i.1
      rw [← hfun]
      exact hLI
    exact LinearIndependent.of_comp P hLI'

/-- N262 in the manuscript's order of operations: first retain labeled
columns `C`, then discard rows spanned by `S`. The indexed column matroid is
unchanged, and every weighted available-column target equation is equivalent
before and after row deletion. -/
theorem rowCompression_after_columnRestriction {r d K : Type*} [Field K]
    [DecidableEq d] (A₀ : Matrix r d K) (C : Finset d)
    (S : Set r) [Fintype S]
    (hspan : ∀ i,
      (A₀.submatrix id (fun j : C => j.1)).row i ∈
        Submodule.span K (Set.range
          ((A₀.submatrix id (fun j : C => j.1)).submatrix
            (fun s : S => s.1) id).row)) :
    vectorMatroid (K := K) (Set.univ : Set C) Set.finite_univ
        (A₀.submatrix id (fun j : C => j.1)).col =
      vectorMatroid (K := K) (Set.univ : Set C) Set.finite_univ
        ((A₀.submatrix id (fun j : C => j.1)).submatrix
          (fun s : S => s.1) id).col ∧
    ∀ (τ : C) (F : Finset C), τ ∉ F →
      ∀ (weightCoeff a : C → K),
        ((A₀.submatrix id (fun j : C => j.1)).submatrix
          (fun s : S => s.1) id).mulVec
            (fun e => if e ∈ F then weightCoeff e * a e else 0) =
          ((A₀.submatrix id (fun j : C => j.1)).submatrix
            (fun s : S => s.1) id).col τ ↔
        (A₀.submatrix id (fun j : C => j.1)).mulVec
            (fun e => if e ∈ F then weightCoeff e * a e else 0) =
          (A₀.submatrix id (fun j : C => j.1)).col τ := by
  classical
  constructor
  · exact rowCompression_vectorMatroid_eq _ S hspan _ _
  · intro τ F hτ weightCoeff a
    exact Matrix.rowCompression_weightedReconstruction_iff _ S hspan τ F hτ weightCoeff a

end Matroid
